<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCourse"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_white"
    app:rippleColor="@color/gmi_blue_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvCourseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diploma in Mechatronics"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/tvCourseDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Engineering Technology"
            android:textSize="12sp"
            android:textColor="@color/text_body"
            android:layout_marginTop="4dp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:id="@+id/buttonContainer">

            <Button
                android:id="@+id/btnWebsite"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Go to Website"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/gmi_blue_primary"/>

            <Button
                android:id="@+id/btnEligibility"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Check Eligibility"
                android:textColor="@color/text_white"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/gmi_accent_teal"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
