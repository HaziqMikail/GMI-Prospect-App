<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GMI Eligibility Checker"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:gravity="center"
            android:padding="16dp"/>

        <!-- Course Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Select Your Course"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <Spinner
            android:id="@+id/spinnerCourse"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:padding="12dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginTop="8dp"/>

        <!-- Qualification Selection Container -->
        <LinearLayout
            android:id="@+id/qualificationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Select Your Qualification"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvQualificationInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#666"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/qualificationGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <!-- Radio buttons will be added dynamically -->
            </RadioGroup>
        </LinearLayout>

        <!-- SPM Fields Layout -->
        <LinearLayout
            android:id="@+id/layoutSPMFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Select Your Grades"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1976D2"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mathematics Grade"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spMathGrade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Science/Technical Subject Grade"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spScienceGrade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bahasa Melayu Grade"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spBM"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="English Grade"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spEnglish"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sejarah"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spSejarah"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Other Subject Grade"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spOtherSubjects"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>
        </LinearLayout>

        <!-- CGPA Fields Layout -->
        <LinearLayout
            android:id="@+id/layoutCGPAFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Enter Your CGPA"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1976D2"/>

            <EditText
                android:id="@+id/etCGPA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter CGPA (e.g., 2.5)"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Minimum CGPA Required: 2.00"
                android:textSize="12sp"
                android:textColor="#666"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- GAPP Fields Layout -->
        <LinearLayout
            android:id="@+id/layoutGAPPFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Select Your Grades"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1976D2"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="English Grade"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spEngGrade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modern Mathematics Grade"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spModernMathGrade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Additional Mathematics Grade"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spAddMathGrade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Physics Grade"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spPhysicsGrade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chemistry Grade"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spChemistryGrade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2 Other Subjects (Average Grade)"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Spinner
                android:id="@+id/spOtherGrade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown"/>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnCheckEligibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Check Eligibility"
                android:textColor="#FFF"
                android:backgroundTint="#4CAF50"
                android:layout_marginEnd="8dp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reset"
                android:textColor="#FFF"
                android:backgroundTint="#FF5722"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Results -->
        <TextView
            android:id="@+id/tvResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:background="#FFF"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"
            android:elevation="2dp"/>

    </LinearLayout>
</ScrollView>