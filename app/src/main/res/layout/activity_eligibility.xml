<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#4CAF50"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eligibility Checker"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check if you qualify for GMI programmes"
                android:textSize="14sp"
                android:textColor="#C8E6C9"
                android:gravity="center"
                android:layout_marginTop="5dp"/>
        </LinearLayout>

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Qualification Type Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="2dp"
                android:radius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select Your Qualification"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#424242"
                        android:layout_marginBottom="12dp"/>

                    <RadioGroup
                        android:id="@+id/qualificationGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbSPM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="SPM (Sijil Pelajaran Malaysia)"
                            android:textSize="16sp"
                            android:padding="8dp"/>

                        <RadioButton
                            android:id="@+id/rbOLevel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="O-Level / IGCSE"
                            android:textSize="16sp"
                            android:padding="8dp"/>

                        <RadioButton
                            android:id="@+id/rbSTAM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="STPM / STAM"
                            android:textSize="16sp"
                            android:padding="8dp"/>

                        <RadioButton
                            android:id="@+id/rbMatriculation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Matriculation / Foundation"
                            android:textSize="16sp"
                            android:padding="8dp"/>

                        <RadioButton
                            android:id="@+id/rbAPEL"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="APEL (Work Experience - 3+ years)"
                            android:textSize="16sp"
                            android:padding="8dp"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Grade Input Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="2dp"
                android:radius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enter Your Grades"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#424242"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mathematics Grade"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginTop="8dp"/>

                    <EditText
                        android:id="@+id/etMathGrade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g., A, B, C"
                        android:inputType="text"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:background="@android:drawable/edit_text"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Science/Technical Subject Grade"
                        android:textSize="14sp"
                        android:textColor="#757575"/>

                    <EditText
                        android:id="@+id/etScienceGrade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g., A, B, C"
                        android:inputType="text"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:background="@android:drawable/edit_text"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Credits / CGPA"
                        android:textSize="14sp"
                        android:textColor="#757575"/>

                    <EditText
                        android:id="@+id/etCredits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g., 5 (credits) or 2.5 (CGPA)"
                        android:inputType="numberDecimal"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:background="@android:drawable/edit_text"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnCheckEligibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Check Eligibility"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4CAF50"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reset"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF5722"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Results Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="2dp"
                android:radius="8dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="400dp">

                    <TextView
                        android:id="@+id/tvResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your eligibility results will appear here..."
                        android:textSize="15sp"
                        android:textColor="#757575"
                        android:padding="16dp"
                        android:lineSpacingExtra="4dp"/>
                </ScrollView>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>