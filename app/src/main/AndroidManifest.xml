<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for web browsing -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phone call permission -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Location permission for maps -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar"
        android:usesCleartextTraffic="true"
        tools:targetApi="m">

        <!-- Activities -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="GMI Prospect App"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CoursesActivity"
            android:exported="false"
            android:label="GMI Courses"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <activity
            android:name=".EligibilityActivity"
            android:exported="false"
            android:label="Eligibility Checker"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <activity
            android:name=".EnquiryActivity"
            android:exported="false"
            android:label="Enquiry"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <activity
            android:name=".ContactUsActivity"
            android:exported="false"
            android:label="Contact Us"
            android:parentActivityName=".EnquiryActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".EnquiryActivity" />
        </activity>

        <activity
            android:name=".AboutUsActivity"
            android:exported="false"
            android:label="About Us"
            android:parentActivityName=".EnquiryActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".EnquiryActivity" />
        </activity>

    </application>

</manifest>
